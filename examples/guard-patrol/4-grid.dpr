{$APPTYPE CONSOLE}
program GuardPatrolGrid;

{ 2-match.delf (19 Oct, before Optional) with a point and a grid
  (user, 23 Oct: Lookup, Start and Advance "read terribly for Delf code").
  Exploring a next phase.

  - Points are System.Types.TPoint (x, y, and +), not (Integer, Integer).
  - TGrid<T> is in its own Delf unit, Demo.Grids (user). It keeps the [y][x]
    order to itself, and it is total: off the grid it answers its border.
  - TCell has three states (user): Open, Wall and Outside, the border. So
    "off the grid" is back inside Advance's match, and the match covers
    every cell with no `_`. The cost: Outside is a real TCell, a named
    sentinel. 5-grid-optional removes even that.
  - The input is a real constant (user), and the grid is made from it with
    a lambda for the cells, not a Cell function used once.
  - Seen is the grid mapped from TCell to Boolean (user); written here as a
    TGrid<Boolean> of the same size, so Seen[Pos] works too.
  - TryStart is Delphi's Try shape, on purpose (user, 23 Oct: "to make a
    point here"): a Boolean, and the start through an out parameter, which
    is undefined when it returns False. No exception, no (-1, -1).
    5-grid-optional returns Optional<TPoint> instead.
  - Names, not letters (user): GuardPos, Facing, Pos, Dir. Coordinates are
    lower case.

  Proposed, not in delfc (user, 23 Oct): declaring a sized array,
    var Seen: array[Length(Grid), Length(Grid[0])] of Boolean;

  Input: the puzzle's published sample (AoC 2024 day 6, part 1).

  Predicted output (Claude, 23 Oct, before compiling): the same as before,
    start: 4 6
    turns: 10
    visited: 41
  No warnings on Win32. On Win64 with -W+IMPLICIT_CONVERSION_LOSS, three
  W1072 (finding 6): one in TryStart (the 64-bit loop variable into Point),
  and two in Demo.Grids, where Length meets Integer in Width and Height. }

uses Delf.Prelude,
  System.SysUtils, System.Types, Demo.Grids;

{ The else of an exhaustive match (SPEC §9.3): unreachable from Delf code, which checks every
  value is covered. noreturn tells dcc32 so, and removes W1035 (experiment 20). }
procedure __dpp_Unreachable(const TypeName: string; Ordinal: Integer); noreturn;
begin
  // the ordinal, not the name: GetEnumName reads past its table for a
  // corrupt value (experiment 27)
  raise EInvalidOpException.CreateFmt('Delf: a match met %s ordinal %d, '
    + 'which it does not cover', [TypeName, Ordinal]);
end;


type
  {$SCOPEDENUMS ON}
  TDir  = (Up, Right, Down, Left);
  {$SCOPEDENUMS OFF}
  {$SCOPEDENUMS ON}
  TCell = (Open, Wall, Outside);
  {$SCOPEDENUMS OFF}

  {$SCOPEDENUMS ON}
  TStepKind = (Moved, Turned, Exited);
  {$SCOPEDENUMS OFF}

  TStep = record
  strict private
    FKind         : TStepKind;
    FMovedPos     : TPoint;
    FTurnedFacing : TDir;
    function GetPos: TPoint;
    function GetFacing: TDir;
  public
    class function Moved(const APos: TPoint): TStep; static; inline;
    class function Turned(const AFacing: TDir): TStep; static; inline;
    class function Exited: TStep; static; inline;
    property Kind   : TStepKind read FKind;
    property Pos    : TPoint    read GetPos;
    property Facing : TDir      read GetFacing;
  end;

{ TStep: generated by Delf from a sum type (SPEC §9.1). A getter's check can't fail from Delf code, where only match reads a payload. }

class function TStep.Moved(const APos: TPoint): TStep;
begin
  Result := Default(TStep);
  Result.FKind     := TStepKind.Moved;
  Result.FMovedPos := APos;
end;

class function TStep.Turned(const AFacing: TDir): TStep;
begin
  Result := Default(TStep);
  Result.FKind         := TStepKind.Turned;
  Result.FTurnedFacing := AFacing;
end;

class function TStep.Exited: TStep;
begin
  Result := Default(TStep);
  Result.FKind := TStepKind.Exited;
end;

function TStep.GetPos: TPoint;
begin
  if FKind <> TStepKind.Moved then
    raise EInvalidOpException.Create('TStep.Pos read on another arm');
  Exit( FMovedPos );
end;

function TStep.GetFacing: TDir;
begin
  if FKind <> TStepKind.Turned then
    raise EInvalidOpException.Create('TStep.Facing read on another arm');
  Exit( FTurnedFacing );
end;

const
  Input: TArray<string> = [
    '....#.....',
    '.........#',
    '..........',
    '..#.......',
    '.......#..',
    '..........',
    '.#..^.....',
    '........#.',
    '#.........',
    '......#...'];

function Step(Dir: TDir): TPoint;
begin
  case Dir of
    TDir.Up    : Exit( Point( 0, -1) );
    TDir.Right : Exit( Point( 1,  0) );
    TDir.Down  : Exit( Point( 0,  1) );
    TDir.Left  : Exit( Point(-1,  0) );
  else
    __dpp_Unreachable('TDir', Ord(Dir));
  end;
end;

function Turn(Dir: TDir): TDir;
begin
  case Dir of
    TDir.Up    : Exit( TDir.Right );
    TDir.Right : Exit( TDir.Down );
    TDir.Down  : Exit( TDir.Left );
    TDir.Left  : Exit( TDir.Up );
  else
    __dpp_Unreachable('TDir', Ord(Dir));
  end;
end;

// Delphi's Try shape, on purpose: Start is only meaningful when this returns True
function TryStart(const Input: TArray<string>; out Start: TPoint): Boolean;
begin
  for var y := 0 to High(Input) do
    if Input[y].Contains('^') then begin Start := Point(Input[y].IndexOf('^'), y); Exit( True ) end;
  Exit( False );
end;

function Advance(const Grid: TGrid<TCell>; const GuardPos: TPoint; Facing: TDir): TStep;
begin
  const Next = GuardPos + Step(Facing);
  var __dpp_1 := Grid[Next];
  case __dpp_1 of
    TCell.Outside : Exit( TStep.Exited );
    TCell.Wall    : Exit( TStep.Turned(Turn(Facing)) );
    TCell.Open    : Exit( TStep.Moved(Next) );
  else
    __dpp_Unreachable('TCell', Ord(__dpp_1));
  end;
end;

begin
  const Grid = TGrid<TCell>.Create(Input, function(Ch: Char): TCell begin Result := if Ch = '#' then TCell.Wall else TCell.Open; end, TCell.Outside);
  var Seen    := TGrid<Boolean>.Create(Grid.Width, Grid.Height, False);

  var GuardPos : TPoint;
  if TryStart(Input, GuardPos) then Seen[GuardPos] := True
                               else begin writeln('no start point found'); Exit; end;

  var Facing  := TDir.Up;
  var Turns   := 0;
  var Visited := 1;

  writeln('start: ', GuardPos.x, ' ', GuardPos.y);

  while True do
  begin
    var __dpp_2 := Advance(Grid, GuardPos, Facing);
    case __dpp_2.Kind of
      TStepKind.Moved  :
        begin
          const Pos = __dpp_2.Pos;
          if not Seen[Pos] then Inc(Visited);
          Seen[Pos] := True;
          GuardPos := Pos;
        end;
      TStepKind.Turned :
        begin
          const Dir = __dpp_2.Facing;
          Inc(Turns);
          Facing := Dir;
        end;
      TStepKind.Exited : Break;
    else
      __dpp_Unreachable('TStepKind', Ord(__dpp_2.Kind));
    end;
  end;

  writeln('turns: ', Turns);
  writeln('visited: ', Visited);
end.
