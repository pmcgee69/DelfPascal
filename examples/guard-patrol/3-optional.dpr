{$APPTYPE CONSOLE}
program GuardPatrolOptional;

{ examples/06-guard-patrol a third time, with Optional and nested patterns
  (23 Oct): SPEC §4.4's own form. 2-match.delf (19 Oct) still
  answered "off the grid" with ' ', a character that only happens not to occur
  in the input (examples/README.md, endnote 3). Here Lookup answers Absent, and
  the grid's characters become TCell once, in Cell, at the edge. Advance is

    match Lookup(Grid, Next) of
      | Absent        : Exited
      | Present(Wall) : Turned(Turn(D))
      | Present(Open) : Moved(Next)
    end

  with no wildcard: add a cell kind and it stops compiling until Advance
  decides what the new kind does.

  Input: the puzzle's published sample (AoC 2024 day 6, part 1).

  Predicted output (Claude, 23 Oct, before compiling): the same as before,
    start: 4 6
    turns: 10
    visited: 41
  and the same diagnostics: none on Win32, one W1072 on Win64 in Start
  (finding 6, poc/examples/README.md). }

uses
  System.SysUtils, Delf.Tuples, Delf.Optional;

{ The else of an exhaustive match (SPEC §9.3): unreachable from Delf code, which checks every
  value is covered. noreturn tells dcc32 so, and removes W1035 (experiment 20). }
procedure __dpp_Unreachable(const TypeName: string; Ordinal: Integer); noreturn;
begin
  // the ordinal, not the name: GetEnumName reads past its table for a
  // corrupt value (experiment 27)
  raise EInvalidOpException.CreateFmt('Delf: a match met %s ordinal %d, '
    + 'which it does not cover', [TypeName, Ordinal]);
end;


type
  {$SCOPEDENUMS ON}
  TDir  = (Up, Right, Down, Left);
  {$SCOPEDENUMS OFF}
  {$SCOPEDENUMS ON}
  TCell = (Open, Wall);
  {$SCOPEDENUMS OFF}

  {$SCOPEDENUMS ON}
  TStepKind = (Moved, Turned, Exited);
  {$SCOPEDENUMS OFF}

  TStep = record
  strict private
    FKind         : TStepKind;
    FMovedPos     : TTuple<Integer, Integer>;
    FTurnedFacing : TDir;
    function GetPos: TTuple<Integer, Integer>;
    function GetFacing: TDir;
  public
    class function Moved(const APos: TTuple<Integer, Integer>): TStep; static; inline;
    class function Turned(const AFacing: TDir): TStep; static; inline;
    class function Exited: TStep; static; inline;
    property Kind   : TStepKind                read FKind;
    property Pos    : TTuple<Integer, Integer> read GetPos;
    property Facing : TDir                     read GetFacing;
  end;

{ TStep: generated by Delf from a sum type (SPEC §9.1). A getter's check can't fail from Delf code, where only match reads a payload. }

class function TStep.Moved(const APos: TTuple<Integer, Integer>): TStep;
begin
  Result := Default(TStep);
  Result.FKind     := TStepKind.Moved;
  Result.FMovedPos := APos;
end;

class function TStep.Turned(const AFacing: TDir): TStep;
begin
  Result := Default(TStep);
  Result.FKind         := TStepKind.Turned;
  Result.FTurnedFacing := AFacing;
end;

class function TStep.Exited: TStep;
begin
  Result := Default(TStep);
  Result.FKind := TStepKind.Exited;
end;

function TStep.GetPos: TTuple<Integer, Integer>;
begin
  if FKind <> TStepKind.Moved then
    raise EInvalidOpException.Create('TStep.Pos read on another arm');
  Exit( FMovedPos );
end;

function TStep.GetFacing: TDir;
begin
  if FKind <> TStepKind.Turned then
    raise EInvalidOpException.Create('TStep.Facing read on another arm');
  Exit( FTurnedFacing );
end;

function Step(D: TDir): TTuple<Integer, Integer>;
begin
  case D of
    TDir.Up    : Exit( TTuple<Integer, Integer>.Create(0, -1) );
    TDir.Right : Exit( TTuple<Integer, Integer>.Create(1, 0) );
    TDir.Down  : Exit( TTuple<Integer, Integer>.Create(0, 1) );
    TDir.Left  : Exit( TTuple<Integer, Integer>.Create(-1, 0) );
  else
    __dpp_Unreachable('TDir', Ord(D));
  end;
end;

function Turn(D: TDir): TDir;
begin
  case D of
    TDir.Up    : Exit( TDir.Right );
    TDir.Right : Exit( TDir.Down );
    TDir.Down  : Exit( TDir.Left );
    TDir.Left  : Exit( TDir.Up );
  else
    __dpp_Unreachable('TDir', Ord(D));
  end;
end;

// the input's characters, read once: '^' marks the start, on an open cell
function Cell(C: Char): TCell;
begin
  case C of
    '#' : Exit( TCell.Wall );
  else
    Exit( TCell.Open );
  end;
end;

function Lookup(const Grid: TArray<string>; const P: TTuple<Integer, Integer>): Optional<TCell>;
begin
  var __dpp_1 := P; const X = __dpp_1.Item0; const Y = __dpp_1.Item1;
  if (Y < 0) or (Y >= Length(Grid))    or
     (X < 0) or (X >= Length(Grid[Y])) then Exit( Optional<TCell>.Absent );
  Exit( Optional<TCell>.Present(Cell(Grid[Y].Chars[X])) );
end;

function Start(const Grid: TArray<string>): TTuple<Integer, Integer>;
begin
  for var Y := 0 to High(Grid) do
    if Grid[Y].Contains('^') then Exit( TTuple<Integer, Integer>.Create(Grid[Y].IndexOf('^'), Y) );
  Exit( TTuple<Integer, Integer>.Create(-1, -1) );
end;

function Advance(const Grid: TArray<string>; const P: TTuple<Integer, Integer>; D: TDir): TStep;
begin
  var __dpp_2 := Step(D); const DX = __dpp_2.Item0; const DY = __dpp_2.Item1;
  const Next: TTuple<Integer, Integer> = TTuple<Integer, Integer>.Create(P.Item0 + DX, P.Item1 + DY);
  var __dpp_3 := Lookup(Grid, Next);
  case __dpp_3.Kind of
    TOptionalKind.Absent  : Exit( TStep.Exited );
    TOptionalKind.Present :
      case __dpp_3.Value of
        TCell.Wall : Exit( TStep.Turned(Turn(D)) );
        TCell.Open : Exit( TStep.Moved(Next) );
      else
        __dpp_Unreachable('TCell', Ord(__dpp_3.Value));
      end;
  else
    __dpp_Unreachable('TOptionalKind', Ord(__dpp_3.Kind));
  end;
end;

begin
  const Grid: TArray<string> = [
    '....#.....',
    '.........#',
    '..........',
    '..#.......',
    '.......#..',
    '..........',
    '.#..^.....',
    '........#.',
    '#.........',
    '......#...'];

  var P       := Start(Grid);
  var D       := TDir.Up;
  var Turns   := 0;
  var Visited := 1;
  var Seen    : TArray<TArray<Boolean>>;
  SetLength(Seen, Length(Grid), Length(Grid[0]));
  Seen[P.Item1][P.Item0] := True;
  WriteLn('start: ', P.Item0, ' ', P.Item1);

  while True do
  begin
    var __dpp_4 := Advance(Grid, P, D);
    case __dpp_4.Kind of
      TStepKind.Moved  :
        begin
          const Q = __dpp_4.Pos;
          var __dpp_5 := Q; const QX = __dpp_5.Item0; const QY = __dpp_5.Item1;
          if not Seen[QY][QX] then Inc(Visited);
          Seen[QY][QX] := True;
          P := Q;
        end;
      TStepKind.Turned :
        begin
          const E = __dpp_4.Facing;
          Inc(Turns);
          D := E;
        end;
      TStepKind.Exited : Break;
    else
      __dpp_Unreachable('TStepKind', Ord(__dpp_4.Kind));
    end;
  end;

  WriteLn('turns: ', Turns);
  WriteLn('visited: ', Visited);
end.
