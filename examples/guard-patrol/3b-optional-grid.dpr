{$APPTYPE CONSOLE}
program GuardPatrolOptionalGrid;

{ 3-optional.delf with a grid type (user, 23 Oct: "the real
  issue here might be Grid[Y].Chars[X]"). The input is parsed once into
  TGrid: the characters become cells there, and the [y][x] order stays inside
  it. Outside, the grid is read the two ways todo-naming.md settles on:
  brackets for a position known to be good (Grid[x, y], which raises), and
  TryGetCell for one that might not be, which returns an Optional.
  Coordinates are lower case (user).

  A side step, kept (user, 23 Oct): points are still tuples here.
  4-grid.delf goes on with TPoint and TGrid<T>.

  Input: the puzzle's published sample (AoC 2024 day 6, part 1).

  Predicted output (Claude, 23 Oct, before compiling): the same as before,
    start: 4 6
    turns: 10
    visited: 41
  No warnings on Win32. On Win64 with -W+IMPLICIT_CONVERSION_LOSS, one W1072
  in Parse, where the 64-bit loop variables go into Start (finding 6). }

uses
  System.SysUtils, Delf.Tuples, Delf.Optional;

{ The else of an exhaustive match (SPEC §9.3): unreachable from Delf code, which checks every
  value is covered. noreturn tells dcc32 so, and removes W1035 (experiment 20). }
procedure __dpp_Unreachable(const TypeName: string; Ordinal: Integer); noreturn;
begin
  // the ordinal, not the name: GetEnumName reads past its table for a
  // corrupt value (experiment 27)
  raise EInvalidOpException.CreateFmt('Delf: a match met %s ordinal %d, '
    + 'which it does not cover', [TypeName, Ordinal]);
end;


type
  {$SCOPEDENUMS ON}
  TDir  = (Up, Right, Down, Left);
  {$SCOPEDENUMS OFF}
  {$SCOPEDENUMS ON}
  TCell = (Open, Wall);
  {$SCOPEDENUMS OFF}

  {$SCOPEDENUMS ON}
  TStepKind = (Moved, Turned, Exited);
  {$SCOPEDENUMS OFF}

  TStep = record
  strict private
    FKind         : TStepKind;
    FMovedPos     : TTuple<Integer, Integer>;
    FTurnedFacing : TDir;
    function GetPos: TTuple<Integer, Integer>;
    function GetFacing: TDir;
  public
    class function Moved(const APos: TTuple<Integer, Integer>): TStep; static; inline;
    class function Turned(const AFacing: TDir): TStep; static; inline;
    class function Exited: TStep; static; inline;
    property Kind   : TStepKind                read FKind;
    property Pos    : TTuple<Integer, Integer> read GetPos;
    property Facing : TDir                     read GetFacing;
  end;

  TGrid = record
    Cells : TArray<TArray<TCell>>;          // [y][x]: the order stays in here
    Start : TTuple<Integer, Integer>;
    function Contains(x, y: Integer): Boolean;
    function GetCell(x, y: Integer): TCell;
    function TryGetCell(x, y: Integer): Optional<TCell>;
    property Items[x, y: Integer]: TCell read GetCell; default;
  end;

{ TStep: generated by Delf from a sum type (SPEC §9.1). A getter's check can't fail from Delf code, where only match reads a payload. }

class function TStep.Moved(const APos: TTuple<Integer, Integer>): TStep;
begin
  Result := Default(TStep);
  Result.FKind     := TStepKind.Moved;
  Result.FMovedPos := APos;
end;

class function TStep.Turned(const AFacing: TDir): TStep;
begin
  Result := Default(TStep);
  Result.FKind         := TStepKind.Turned;
  Result.FTurnedFacing := AFacing;
end;

class function TStep.Exited: TStep;
begin
  Result := Default(TStep);
  Result.FKind := TStepKind.Exited;
end;

function TStep.GetPos: TTuple<Integer, Integer>;
begin
  if FKind <> TStepKind.Moved then
    raise EInvalidOpException.Create('TStep.Pos read on another arm');
  Exit( FMovedPos );
end;

function TStep.GetFacing: TDir;
begin
  if FKind <> TStepKind.Turned then
    raise EInvalidOpException.Create('TStep.Facing read on another arm');
  Exit( FTurnedFacing );
end;

function TGrid.Contains(x, y: Integer): Boolean;
begin
  Exit( (y >= 0) and (y < Length(Cells))    and
        (x >= 0) and (x < Length(Cells[y])) );
end;

function TGrid.GetCell(x, y: Integer): TCell;
begin
  if not Contains(x, y) then
    raise ERangeError.CreateFmt('(%d, %d) is off the grid', [x, y]);
  Exit( Cells[y][x] );
end;

function TGrid.TryGetCell(x, y: Integer): Optional<TCell>;
begin
  if not Contains(x, y) then Exit( Optional<TCell>.Absent );
  Exit( Optional<TCell>.Present(Self[x, y]) );
end;

function Cell(C: Char): TCell;
begin
  case C of
    '#' : Exit( TCell.Wall );
  else
    Exit( TCell.Open );
  end;
end;

// the input's characters, read once: '^' marks the start, on an open cell
function Parse(const Lines: TArray<string>): TGrid;
begin
  SetLength(Result.Cells, Length(Lines));
  for var y := 0 to High(Lines) do
  begin
    SetLength(Result.Cells[y], Length(Lines[y]));
    for var x := 0 to High(Result.Cells[y]) do
    begin
      const C = Lines[y].Chars[x];
      Result.Cells[y][x] := Cell(C);
      if C = '^' then Result.Start := TTuple<Integer, Integer>.Create(x, y);
    end;
  end;
end;

function Step(D: TDir): TTuple<Integer, Integer>;
begin
  case D of
    TDir.Up    : Exit( TTuple<Integer, Integer>.Create(0, -1) );
    TDir.Right : Exit( TTuple<Integer, Integer>.Create(1, 0) );
    TDir.Down  : Exit( TTuple<Integer, Integer>.Create(0, 1) );
    TDir.Left  : Exit( TTuple<Integer, Integer>.Create(-1, 0) );
  else
    __dpp_Unreachable('TDir', Ord(D));
  end;
end;

function Turn(D: TDir): TDir;
begin
  case D of
    TDir.Up    : Exit( TDir.Right );
    TDir.Right : Exit( TDir.Down );
    TDir.Down  : Exit( TDir.Left );
    TDir.Left  : Exit( TDir.Up );
  else
    __dpp_Unreachable('TDir', Ord(D));
  end;
end;

function Advance(const Grid: TGrid; const P: TTuple<Integer, Integer>; D: TDir): TStep;
begin
  var __dpp_1 := P; const x = __dpp_1.Item0; const y = __dpp_1.Item1;
  var __dpp_2 := Step(D); const dx = __dpp_2.Item0; const dy = __dpp_2.Item1;
  const nx = x + dx; const ny = y + dy;
  var __dpp_3 := Grid.TryGetCell(nx, ny);
  case __dpp_3.Kind of
    TOptionalKind.Absent  : Exit( TStep.Exited );
    TOptionalKind.Present :
      case __dpp_3.Value of
        TCell.Wall : Exit( TStep.Turned(Turn(D)) );
        TCell.Open : Exit( TStep.Moved(TTuple<Integer, Integer>.Create(nx, ny)) );
      else
        __dpp_Unreachable('TCell', Ord(__dpp_3.Value));
      end;
  else
    __dpp_Unreachable('TOptionalKind', Ord(__dpp_3.Kind));
  end;
end;

begin
  const Grid = Parse([
    '....#.....',
    '.........#',
    '..........',
    '..#.......',
    '.......#..',
    '..........',
    '.#..^.....',
    '........#.',
    '#.........',
    '......#...']);

  var P       := Grid.Start;
  var D       := TDir.Up;
  var Turns   := 0;
  var Visited := 1;
  var Seen    : TArray<TArray<Boolean>>;
  SetLength(Seen, Length(Grid.Cells), Length(Grid.Cells[0]));
  var __dpp_4 := P; const sx = __dpp_4.Item0; const sy = __dpp_4.Item1;
  Seen[sy][sx] := True;
  WriteLn('start: ', sx, ' ', sy);

  while True do
  begin
    var __dpp_5 := Advance(Grid, P, D);
    case __dpp_5.Kind of
      TStepKind.Moved  :
        begin
          const Q = __dpp_5.Pos;
          var __dpp_6 := Q; const qx = __dpp_6.Item0; const qy = __dpp_6.Item1;
          if not Seen[qy][qx] then Inc(Visited);
          Seen[qy][qx] := True;
          P := Q;
        end;
      TStepKind.Turned :
        begin
          const E = __dpp_5.Facing;
          Inc(Turns);
          D := E;
        end;
      TStepKind.Exited : Break;
    else
      __dpp_Unreachable('TStepKind', Ord(__dpp_5.Kind));
    end;
  end;

  WriteLn('turns: ', Turns);
  WriteLn('visited: ', Visited);
end.
