{$APPTYPE CONSOLE}
program GuardPatrolGridOptional;

{ 4-grid.delf with Optional (user, 23 Oct), kept line for line where it can
  be, so the two compare directly.

  - The grid is Demo.OptionalGrids (user: its own unit): partial, where
    4-grid's is total. TryGet answers Absent off the grid.
  - So TCell is back to two states, Open and Wall. Off the grid isn't a
    cell any more, it's Absent, and nothing can store it in the grid.
  - Start returns Optional<TPoint>, where 4-grid's TryStart had a Boolean
    and an out parameter (the slide on the out pattern). The arm that has
    the point declares GuardPos (user, 23 Oct): a TPoint from here on, not
    an Optional, and the other arm leaves. delfc declares it before the
    case and assigns it in the arm.
  - The input is a TGrid<Char> (user, 23 Oct), made from the lines with Id,
    the prelude's identity. The other two grids are maps of it, side by
    side (user): Grid through CharToCell, Seen through a lambda that
    answers False.
  - Start goes through the input's Rows; each row knows its Index, and Find
    answers an Optional<Integer>, which Start matches. The Absent arm is
    empty, a comment saying skip (user): the loop goes on. SPEC §4.5a calls an empty arm
    on an Optional a smell; its narrowing form, is Present(x), isn't in
    delfc yet.
  - Step answers a TPointDelta, a move rather than a place, written as a
    record literal with its field names, (dx: 0; dy: -1) (user, 23 Oct:
    not positional, (0, -1), where field order would become meaning), and
    TPoint + TPointDelta is a TPoint; ToString shows a point. Both are in
    the prelude (user: the RTL's TPoint.Offset is a procedure, "evil").

  Input: the puzzle's published sample (AoC 2024 day 6, part 1).

  Predicted output (Claude, 23 Oct, before compiling): as before, with the
  start shown by ToString,
    start: (4, 6)
    turns: 10
    visited: 41
  No warnings on Win32. On Win64 with -W+IMPLICIT_CONVERSION_LOSS, six
  W1072 (finding 6), all in Demo.OptionalGrids, where a 64-bit index from
  High meets an Integer: Width and Height; Map, twice (x and y into Point);
  Rows (y into Index); Find (x into Present). }

uses Delf.Prelude,
  System.SysUtils, System.Types, Demo.OptionalGrids, Delf.Optional;

{ The else of an exhaustive match (SPEC §9.3): unreachable from Delf code, which checks every
  value is covered. noreturn tells dcc32 so, and removes W1035 (experiment 20). }
procedure __dpp_Unreachable(const TypeName: string; Ordinal: Integer); noreturn;
begin
  // the ordinal, not the name: GetEnumName reads past its table for a
  // corrupt value (experiment 27)
  raise EInvalidOpException.CreateFmt('Delf: a match met %s ordinal %d, '
    + 'which it does not cover', [TypeName, Ordinal]);
end;


{ Spontaneous-record maker, generated by Delf: one per record type built from a literal. }
function __dpp_Lit_TPointDelta(const dx: Integer; const dy: Integer): TPointDelta;
begin
  Result.dx := dx;
  Result.dy := dy;
end;

const
  Lines: TArray<string> = [
    '....#.....',
    '.........#',
    '..........',
    '..#.......',
    '.......#..',
    '..........',
    '.#..^.....',
    '........#.',
    '#.........',
    '......#...'];

type
  {$SCOPEDENUMS ON}
  TDir  = (Up, Right, Down, Left);
  {$SCOPEDENUMS OFF}
  {$SCOPEDENUMS ON}
  TCell = (Open, Wall);
  {$SCOPEDENUMS OFF}

  {$SCOPEDENUMS ON}
  TStepKind = (Moved, Turned, Exited);
  {$SCOPEDENUMS OFF}

  TStep = record
  strict private
    FKind         : TStepKind;
    FMovedPos     : TPoint;
    FTurnedFacing : TDir;
    function GetPos: TPoint;
    function GetFacing: TDir;
  public
    class function Moved(const APos: TPoint): TStep; static; inline;
    class function Turned(const AFacing: TDir): TStep; static; inline;
    class function Exited: TStep; static; inline;
    property Kind   : TStepKind read FKind;
    property Pos    : TPoint    read GetPos;
    property Facing : TDir      read GetFacing;
  end;

{ TStep: generated by Delf from a sum type (SPEC §9.1). A getter's check can't fail from Delf code, where only match reads a payload. }

class function TStep.Moved(const APos: TPoint): TStep;
begin
  Result := Default(TStep);
  Result.FKind     := TStepKind.Moved;
  Result.FMovedPos := APos;
end;

class function TStep.Turned(const AFacing: TDir): TStep;
begin
  Result := Default(TStep);
  Result.FKind         := TStepKind.Turned;
  Result.FTurnedFacing := AFacing;
end;

class function TStep.Exited: TStep;
begin
  Result := Default(TStep);
  Result.FKind := TStepKind.Exited;
end;

function TStep.GetPos: TPoint;
begin
  if FKind <> TStepKind.Moved then
    raise EInvalidOpException.Create('TStep.Pos read on another arm');
  Exit( FMovedPos );
end;

function TStep.GetFacing: TDir;
begin
  if FKind <> TStepKind.Turned then
    raise EInvalidOpException.Create('TStep.Facing read on another arm');
  Exit( FTurnedFacing );
end;

function Step(Dir: TDir): TPointDelta;
begin
  case Dir of
    TDir.Up    : Exit( __dpp_Lit_TPointDelta(0, -1) );
    TDir.Right : Exit( __dpp_Lit_TPointDelta(1, 0) );
    TDir.Down  : Exit( __dpp_Lit_TPointDelta(0, 1) );
    TDir.Left  : Exit( __dpp_Lit_TPointDelta(-1, 0) );
  else
    __dpp_Unreachable('TDir', Ord(Dir));
  end;
end;

function Turn(Dir: TDir): TDir;
begin
  case Dir of
    TDir.Up    : Exit( TDir.Right );
    TDir.Right : Exit( TDir.Down );
    TDir.Down  : Exit( TDir.Left );
    TDir.Left  : Exit( TDir.Up );
  else
    __dpp_Unreachable('TDir', Ord(Dir));
  end;
end;

function Start(const Input: TGrid<Char>): Optional<TPoint>;
begin
  for var Row in Input.Rows do
    begin
      var __dpp_1 := Row.Find('^');
      case __dpp_1.Kind of
        TOptionalKind.Present :
          begin
            const x = __dpp_1.Value;
            Exit( Optional<TPoint>.Present(Point(x, Row.Index)) );
          end;
        TOptionalKind.Absent  : ;
      else
        __dpp_Unreachable('TOptionalKind', Ord(__dpp_1.Kind));
      end
    end;
  Exit( Optional<TPoint>.Absent );
end;

function Advance(const Grid: TGrid<TCell>; const GuardPos: TPoint; Facing: TDir): TStep;
begin
  const Next = GuardPos + Step(Facing);
  var __dpp_2 := Grid.TryGet(Next);
  case __dpp_2.Kind of
    TOptionalKind.Present :
      case __dpp_2.Value of
        TCell.Wall : Exit( TStep.Turned(Turn(Facing)) );
        TCell.Open : Exit( TStep.Moved(Next) );
      else
        __dpp_Unreachable('TCell', Ord(__dpp_2.Value));
      end;
    TOptionalKind.Absent  : Exit( TStep.Exited );
  else
    __dpp_Unreachable('TOptionalKind', Ord(__dpp_2.Kind));
  end;
end;

// In Delphi,
//   const CharToCell: TFunc<Char, TCell> =
//     function(Ch: Char): TCell begin Result := if Ch = '#' then Wall else Open; end;
//
// and λch -> False
//   function(ch: Char): Boolean begin Result := False; end
begin
  const Input = TGrid<Char>.Create(Lines, TFunctions.Id<Char>);

  const CharToCell: TFunc<Char, TCell> = function(Ch: Char): TCell begin Result := if Ch = '#' then TCell.Wall else TCell.Open; end;
  const Grid = Input.Map<TCell>(CharToCell);
  var   Seen  := Input.Map<Boolean>(function(ch: Char): Boolean begin Result := False; end);

  var __dpp_3 := Start(Input);
  var GuardPos: TPoint;
  case __dpp_3.Kind of
    TOptionalKind.Present :
      begin
        const Pos = __dpp_3.Value;
        GuardPos := Pos;
      end;
    TOptionalKind.Absent  : begin writeln('no start point found'); Exit; end;
  else
    __dpp_Unreachable('TOptionalKind', Ord(__dpp_3.Kind));
  end;

  Seen[GuardPos] := True;

  var Facing  := TDir.Up;
  var Turns   := 0;
  var Visited := 1;

  writeln('start: ', GuardPos.ToString);

  while True do
  begin
    var __dpp_4 := Advance(Grid, GuardPos, Facing);
    case __dpp_4.Kind of
      TStepKind.Moved  :
        begin
          const Pos = __dpp_4.Pos;
          if not Seen[Pos] then begin Inc(Visited);  Seen[Pos] := True; end;
          GuardPos := Pos;
        end;
      TStepKind.Turned :
        begin
          const Dir = __dpp_4.Facing;
          Inc(Turns);
          Facing := Dir;
        end;
      TStepKind.Exited : Break;
    else
      __dpp_Unreachable('TStepKind', Ord(__dpp_4.Kind));
    end;
  end;

  writeln('turns: ', Turns);
  writeln('visited: ', Visited);
end.
